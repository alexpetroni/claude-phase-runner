# claude-phase-runner — per-project configuration.
# Lives in <project>/.phase-runner/ (excluded from git via .git/info/exclude).
# All paths are RELATIVE TO THE PROJECT ROOT. The phases themselves are listed
# in the `phases` file next to this one, one per line, in order.

# The entry/constitution prompt: mission, binding rules, invariants, how to
# verify. Prepended to every builder, reviewer and report prompt. Keep phase
# scoping OUT of it — the runner adds that per phase — and do not ask the
# builder to verify itself: the runner's independent reviewer does that.
ENTRY_FILE=docs/ENTRY.md

# Independent verification command run from the project root after every
# builder run. Red → the builder gets a fix round with the output. Empty = no
# gate (the reviewer still runs and must run the checks itself).
GATE_CMD="pnpm lint && pnpm typecheck && pnpm test"

# ── Reviewer ──────────────────────────────────────────────────────────────────
# After every builder run a reviewer with a fresh context and no edit tools
# audits each Definition of Done item against the repository and the diff and
# returns PASS or FAIL with findings. 0 disables it (gate only).
PHASE_REVIEW=1
# Fix rounds per phase (gate red or reviewer FAIL) before the phase is recorded
# as blocked and the run stops for the human.
MAX_FIX_ROUNDS=2
# Also commit the latest verdict into the repository as <REVIEWS_DIR>/<phase>.md.
COMMIT_REVIEWS=0
#REVIEWS_DIR=docs/verification

# ── Models, effort, spend ─────────────────────────────────────────────────────
# Where a builder run's money goes (measured, Fable 5.1 at xhigh): ~40% output
# tokens (about 40% of those are thinking), ~40% cache writes of tool output,
# ~16% cache reads, <2% fresh input. Effort is the biggest lever, tool-output
# volume the second; the reviewer adds 15–30% on top of the builder.
#
# Resolution, most specific first: per-phase option in `phases` → per-role
# variable → CLAUDE_*. With nothing set every role runs claude-fable-5-1 at
# xhigh. Effort levels: low, medium, high, xhigh, max.
#
# Recommended split (Fable 5.1 guidance: `high` for most work, `xhigh` for the
# most capability-sensitive; `high` on Fable 5.1 still exceeds `xhigh` on the
# previous generation): build at high, escalate fix rounds, judge at high, and
# put `effort=xhigh` on the hard phases in `phases` rather than on every phase.
#CLAUDE_MODEL=claude-fable-5-1
#CLAUDE_EFFORT=xhigh
BUILD_EFFORT=high
#BUILD_MODEL=
# Fix rounds run only after a failure signal, so spend more there: "run at the
# lower setting, re-run failures at the higher one" holds pass rate at about
# half the cost. Leave FIX_EFFORT unset with FIX_CONTEXT=resume (an effort
# change invalidates the resumed session's cache).
FIX_EFFORT=xhigh
#FIX_MODEL=
# The reviewer's judgement is what makes the loop safe: keep the strong model.
REVIEW_EFFORT=high
#REVIEW_MODEL=
# Subagents the agents spawn (Explore, general-purpose, a test-file audit) do
# routine reading and searching — route them to a cheaper model. An agent
# definition that names its own model still wins.
SUBAGENT_MODEL=claude-sonnet-5
# Characters of a Bash result (test output, logs) that enter the context inline;
# the rest is saved to a file the agent can grep. Claude Code's default: 30000.
BASH_OUTPUT_MAX_CHARS=16000
# Fix rounds: `fresh` starts a new context (independent of the builder's wrong
# assumptions); `resume` continues the builder's own session, which is cheaper
# when gate + review finish inside the 1-hour prompt-cache window and costs a
# full cache rewrite when they do not.
FIX_CONTEXT=fresh
# Hard spend caps per agent run, in USD. Hitting one stops the run honestly.
#BUILD_BUDGET_USD=40
#REVIEW_BUDGET_USD=10

# ── Resilience ────────────────────────────────────────────────────────────────
# Seconds to wait before each retry after a transient API failure or stall.
# The list's length IS the retry count: below = 4 retries (30s, 5m, 1h, 3h).
RETRY_SCHEDULE="30 300 3600 10800"
# Kill + retry an agent that produced no output for this many seconds. Keep it
# above your slowest silent step (a docker build or a big test suite is ONE
# tool call that prints nothing until it ends).
STALL_TIMEOUT=1800
# The agent's Bash tool. Claude Code moves a command that outruns its timeout
# to the background, and in a headless run the agent then ends its turn to
# wait for a notification that never arrives — the main cause of builders
# reporting "verification still running". So: every command stays in the
# foreground with a generous timeout, and background tasks are off.
# BASH_TIMEOUT: seconds a Bash call may run when the agent passes no timeout
# (default 600, capped at BASH_TIMEOUT_MAX). BASH_TIMEOUT_MAX: the longest
# timeout the agent may ask for; must stay below STALL_TIMEOUT, because a
# foreground command prints nothing until it ends and the watchdog would kill
# it (default STALL_TIMEOUT - 300, never below 120). BACKGROUND_TASKS=1 gives
# Claude Code's own behaviour back (run_in_background and auto-backgrounding).
#BASH_TIMEOUT=600
#BASH_TIMEOUT_MAX=1500
#BACKGROUND_TASKS=0
# The gate is not an agent, so the watchdog above does not cover it: this caps
# the whole GATE_CMD in seconds. It runs with stdin closed, so a tool that asks
# a question fails instead of waiting forever.
GATE_TIMEOUT=3600
# A subscription usage window is judged by the CLI's rejected rate_limit_event:
# a reset within this many seconds is waited out and the same session resumed;
# one further away stops the run at once, naming the reset time to re-run after.
#LIMIT_WAIT_MAX=21600

# ── Git ───────────────────────────────────────────────────────────────────────
# Commit after every role; push after every verified phase. The agent itself
# can never push (blocked by the guard hook).
PUSH=1
GIT_REMOTE=origin
# Empty = the branch currently checked out.
GIT_BRANCH=
#GIT_AUTHOR_NAME=Phase Runner
#GIT_AUTHOR_EMAIL=runner@phase.local

# ── Image / environment ───────────────────────────────────────────────────────
# Extra apt packages for non-JS toolchains (applied at image build).
#EXTRA_APT_PACKAGES="python3 python3-pip"
# Pin Claude Code for reproducible runs (default: latest at image build time).
#CLAUDE_CODE_VERSION=2.1.259
# The agent's ~/.claude (drop skills/, agents/, plugins here; sessions persist).
#AGENT_HOME=.phase-runner/home
# The host's Docker socket. 1 mounts it, so the agent can start the project's
# stack and test containers on the host daemon (docker-out-of-docker) — and
# that socket is effectively root on the host. 0 gives the agent no daemon:
# services and tests run as plain processes in the runner container. Off here;
# turn it on only for a project whose phases really need containers. Left
# unset it is 1, which is what projects created before this setting get.
DOCKER_SOCKET=0

# ── Final review (`phase-runner review`) ──────────────────────────────────────
#REVIEW_PROMPT="Make an adversarial evaluation of what can be improved, simplified, and made more resilient. Do it thoroughly."

# ── Escape hatch ──────────────────────────────────────────────────────────────
# Disable the enforcement hook (no-push, no-destructive-git, protected files,
# read-only reviewer). Not recommended.
#GUARD=0
