# Agent credentials — user-level, one file per machine:
#   mkdir -p ~/.config/claude-phase-runner && cp this-file ~/.config/claude-phase-runner/credentials.env
# Set EXACTLY ONE (OAuth wins). Never commit it, never put it inside a project:
# the agent manages the project's own .env files and must never see its token.

# Subscription auth — generate with: claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=

# OR API billing:
#ANTHROPIC_API_KEY=
