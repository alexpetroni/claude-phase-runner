#!/usr/bin/env bash
# Fake Claude Code for driver tests. Each invocation pops the first line of
# $FAKE_PLAN — "<role>:<outcome>" — checks that the driver launched it with
# that role, behaves accordingly, and emits stream-json on stdout like the
# real CLI. Arguments, prompt and role are recorded under $FAKE_LOG/<n>.* so
# tests can assert on what the driver sent.
set -uo pipefail
: "${FAKE_PLAN:?}" "${FAKE_LOG:?}"

if [[ "${1:-}" == "--version" ]]; then echo "0.0.0 (fake)"; exit 0; fi

mkdir -p "$FAKE_LOG"
n=$(( $(find "$FAKE_LOG" -name '*.args' | wc -l) + 1 ))
printf '%s\n' "$@" > "$FAKE_LOG/$n.args"
prompt=""; prev=""; sid=""; resumed=0
for a in "$@"; do
  [[ "$prev" == "-p" ]] && prompt="$a"
  case "$prev" in --session-id) sid="$a" ;; --resume) sid="$a"; resumed=1 ;; esac
  prev="$a"
done
printf '%s' "$prompt" > "$FAKE_LOG/$n.prompt"
role="${PHASE_RUNNER_ROLE:-}"
echo "$role" > "$FAKE_LOG/$n.role"
env | grep -E '^(CLAUDE_CODE_|BASH_DEFAULT_TIMEOUT_MS=|BASH_MAX_TIMEOUT_MS=)' > "$FAKE_LOG/$n.env" || true

line="$(head -n1 "$FAKE_PLAN")"
sed -i '1d' "$FAKE_PLAN"
if [[ -z "$line" ]]; then
  echo "fake-claude: plan exhausted at invocation $n (role '$role')" >&2; exit 97
fi
want="${line%%:*}"; outcome="${line#*:}"
if [[ "$want" != "$role" ]]; then
  echo "fake-claude: invocation $n expected role '$want' but the driver launched '$role'" >&2; exit 98
fi

emit() { printf '%s\n' "$1"; }
say()  { emit "{\"type\":\"assistant\",\"message\":{\"content\":[{\"type\":\"text\",\"text\":$(jq -Rn --arg t "$1" '$t')}]}}"; }
# Like the real CLI, a resumed session reports total_cost_usd cumulatively
# (0.3 from the interrupted attempt + 0.5 from this one); num_turns is per call.
result() { emit "{\"type\":\"result\",\"subtype\":\"success\",\"duration_ms\":60000,\"total_cost_usd\":$([[ $resumed == 1 ]] && echo 0.8 || echo 0.5),\"num_turns\":3,\"session_id\":\"$sid\",\"structured_output\":$1}"; }
# A failed call: the CLI's error text lands in the result event, cost so far attached.
fail_result() { emit "{\"type\":\"result\",\"subtype\":\"success\",\"is_error\":true,\"duration_ms\":1000,\"total_cost_usd\":0.3,\"num_turns\":2,\"session_id\":\"$sid\",\"result\":$(jq -Rn --arg t "$1" '$t')}"; }
# The CLI's rate_limit_event in its real shape. Only rate_limit_info.status
# says whether the request was rejected: the overage fields describe the
# account and read "rejected"/"out_of_credits" on allowed events too.
rate_limit_event() {  # rate_limit_event allowed|rejected TYPE RESETS_AT
  local five=0.55 over=0.88 at5=$(( $3 + 3600 )) at7=$(( $3 + 86400 ))
  case "$2" in five_hour) five=1; at5=$3 ;; seven_day_overage_included) over=1; at7=$3 ;; esac
  emit "{\"type\":\"rate_limit_event\",\"rate_limit_info\":{\"status\":\"$1\",\"resetsAt\":$3,\"rateLimitType\":\"$2\",\"overageStatus\":\"rejected\",\"overageDisabledReason\":\"out_of_credits\",\"isUsingOverage\":false,\"unifiedWindows\":{\"five_hour\":{\"utilization\":$five,\"resetsAt\":$at5},\"seven_day\":{\"utilization\":0.51,\"resetsAt\":$at7},\"seven_day_overage_included\":{\"utilization\":$over,\"resetsAt\":$at7}}}}"
}
emit "{\"type\":\"system\",\"subtype\":\"init\",\"session_id\":\"$sid\",\"model\":\"fake\",\"claude_code_version\":\"0.0.0\",\"mcp_servers\":[]}"

# The phase file named in the prompt (first `….md` in backticks) names the work file.
phase="$(grep -oE '`[^`]+\.md`' <<<"$prompt" | head -1 | tr -d '`')"
tag="$(basename "${phase:-unknown}" .md)"

commit_work() {
  echo "invocation $n ($role:$outcome)" >> "built-$tag.txt"
  git add -A >/dev/null
  git commit -q -m "$1" >/dev/null
}

case "$role:$outcome" in
  build:ok|fix:ok)
    say "Working on $tag"
    commit_work "feat($tag): fake work $n"
    result "{\"status\":\"done\",\"summary\":\"fake $role $n done\",\"commits\":[\"fake work $n\"]}" ;;
  build:gatefix|fix:gatefix)
    say "Making the gate green"
    touch gate-ok
    commit_work "fix($tag): gate green $n"
    result "{\"status\":\"done\",\"summary\":\"gate fixed\"}" ;;
  build:uncommitted)
    echo "leftover" > "leftover-$tag.txt"
    result "{\"status\":\"done\",\"summary\":\"forgot to commit\"}" ;;
  build:noreport)
    commit_work "feat($tag): work without report $n"
    emit '{"type":"result","subtype":"success","duration_ms":1000,"total_cost_usd":0.1,"num_turns":1,"result":"plain text, no schema"}' ;;
  build:blocked|fix:blocked)
    say "Cannot proceed"
    result "{\"status\":\"blocked\",\"summary\":\"needs an API key\",\"blockers\":\"MARKER-BLOCKER\"}" ;;
  build:blockedwork|fix:blockedwork)
    say "Did the work, tests still running in the background"
    commit_work "feat($tag): fake work $n"
    result "{\"status\":\"blocked\",\"summary\":\"work committed, verification not observed\",\"blockers\":\"MARKER-BLOCKER\"}" ;;
  build:transient|fix:transient|review:transient)
    say "starting"
    echo 'API Error: 529 {"type":"error","error":{"type":"overloaded_error","message":"Overloaded"}}'
    fail_result 'API Error: 529 {"type":"error","error":{"type":"overloaded_error","message":"Overloaded"}}'
    exit 1 ;;
  # Usage limits, each with the result text the real CLI paired it with. The
  # five-hour windows reset three seconds ahead (one second raced the driver's
  # clock); the weekly one FAKE_LIMIT_RESET_IN seconds ahead, a day by default.
  build:limit|review:limit)
    say "starting"
    rate_limit_event rejected five_hour $(( $(date +%s) + 3 ))
    fail_result "You've hit your session limit · resets 4:10pm (UTC)"
    exit 1 ;;
  build:limitcredits)
    say "starting"
    rate_limit_event rejected five_hour $(( $(date +%s) + 3 ))
    fail_result "You're out of usage credits · resets 8:40pm (UTC)"
    exit 1 ;;
  build:weekly)
    say "starting"
    rate_limit_event rejected seven_day_overage_included $(( $(date +%s) + ${FAKE_LIMIT_RESET_IN:-86400} ))
    fail_result "You're out of usage credits. Switch to another model to continue."
    exit 1 ;;
  build:nocredits)   # out of credit with no rejected event: nothing to wait for
    say "starting"
    fail_result "You're out of usage credits. /model to switch models."
    exit 1 ;;
  build:allowed)     # a healthy run's event, then a plain 529: not a rejection
    say "starting"
    rate_limit_event allowed five_hour $(( $(date +%s) + 7200 ))
    fail_result 'API Error: 529 {"type":"error","error":{"type":"overloaded_error","message":"Overloaded"}}'
    exit 1 ;;
  build:stall|review:stall)
    say "thinking"
    trap 'kill $(jobs -p) 2>/dev/null; exit 143' TERM
    sleep 300 & wait
    exit 1 ;;
  build:nosession|fix:nosession)
    echo "No conversation found with session ID $sid"
    exit 1 ;;
  build:fatal)
    echo "Error: something non-transient happened"
    exit 1 ;;
  review:PASS)
    say "Reviewing"
    result '{"verdict":"PASS","summary":"all good","dod":[{"item":"A works","verdict":"PASS","evidence":"ran it"}],"findings":[]}' ;;
  review:FAIL)
    say "Reviewing"
    result "{\"verdict\":\"FAIL\",\"summary\":\"not done\",\"dod\":[{\"item\":\"A works\",\"verdict\":\"FAIL\",\"evidence\":\"no test\"}],\"findings\":[{\"severity\":\"high\",\"file\":\"src/a.ts\",\"line\":3,\"what\":\"MARKER-FINDING-$n\",\"fix\":\"add the test\"}]}" ;;
  review:dirty)
    echo "junk" > stray-from-reviewer.txt
    result '{"verdict":"PASS","summary":"good, but I left a file behind","dod":[],"findings":[]}' ;;
  preflight:dirty)
    echo "junk" > stray-from-preflight.txt
    echo "edited by preflight" >> plan/ENTRY.md
    result "{\"report\":\"# Report from $role $n\\n\\nMARKER-REPORT\"}" ;;
  preflight:ok|final-review:ok)
    result "{\"report\":\"# Report from $role $n\\n\\nMARKER-REPORT\"}" ;;
  *)
    echo "fake-claude: unknown plan line '$line'" >&2; exit 99 ;;
esac
exit 0
