#!/usr/bin/env bash
# phase-runner — host CLI for claude-phase-runner.
#
# Run it from inside the target project (or pass --project DIR). Everything
# per-project lives in <project>/.phase-runner/ — config, phase manifest,
# state, verdicts, logs, agent home — excluded from git via .git/info/exclude.
# The kit directory holds code only. Credentials are user-level.
set -euo pipefail

SELF="$(readlink -f "${BASH_SOURCE[0]}")"
KIT_DIR="$(cd "$(dirname "$SELF")/.." && pwd)"

usage() {
  cat <<'EOF'
phase-runner — autonomous phased builds with Claude Code: one builder and one
independent reviewer per phase, retries, resume, commit + push per phase.

Usage: phase-runner [--project DIR] <command> [options]

  init                 create .phase-runner/ (runner.env + phases manifest) in the project
  build [--dry-run]    run every pending phase (default command):
                         builder → checkpoint → gate → reviewer → fix rounds → record → push
  preflight            read-only tooling/credentials assessment → .phase-runner/state/TOOLING.md
  review               read-only adversarial review of the finished project → .phase-runner/state/REVIEW.md
  status               phases with status, verdict, fix rounds, cost, minutes
  logs [PHASE] [-f]    readable agent transcript (latest log by default; -f follows a live run)
  logs driver [-f]     the runner's own log: starts, retries, waits, verdicts, stops, across runs
  reset [--yes]        delete .phase-runner/state (config and agent home are kept)

The project is the git repository containing the current directory unless
--project is given (or PHASE_RUNNER_PROJECT is set).
Credentials: ~/.config/claude-phase-runner/credentials.env (override with
PHASE_RUNNER_CREDENTIALS). Template: templates/credentials.env in the kit.
EOF
}

die()  { printf '\033[1;31m✗ %s\033[0m\n' "$*" >&2; exit 1; }
info() { printf '\033[1;34m▶ %s\033[0m\n' "$*"; }
warn() { printf '\033[1;33m⚠ %s\033[0m\n' "$*" >&2; }

# ── Arguments ─────────────────────────────────────────────────────────────────
PROJECT_DIR="${PHASE_RUNNER_PROJECT:-}"
CMD=""
ARGS=()
while (( $# )); do
  case "$1" in
    --project)   PROJECT_DIR="${2:?--project needs a directory}"; shift 2 ;;
    --project=*) PROJECT_DIR="${1#*=}"; shift ;;
    -h|--help|help) usage; exit 0 ;;
    *) if [[ -z "$CMD" ]]; then CMD="$1"; else ARGS+=("$1"); fi; shift ;;
  esac
done
CMD="${CMD:-build}"
has_arg() { local a; for a in "${ARGS[@]}"; do [[ "$a" == "$1" ]] && return 0; done; return 1; }

# ── Project ───────────────────────────────────────────────────────────────────
resolve_project() {
  if [[ -z "$PROJECT_DIR" ]]; then
    PROJECT_DIR="$(git rev-parse --show-toplevel 2>/dev/null)" \
      || die "not inside a git repository — cd into the target project or pass --project DIR"
  fi
  PROJECT_DIR="$(cd "$PROJECT_DIR" 2>/dev/null && pwd)" || die "project directory not found: $PROJECT_DIR"
  [[ -e "$PROJECT_DIR/.git" ]] || die "not a git repository: $PROJECT_DIR"
  [[ "$PROJECT_DIR" == *" "* ]] && die "the project path contains a space; docker bind mounts of it are unreliable: $PROJECT_DIR"
  PR_DIR="$PROJECT_DIR/.phase-runner"
  STATE="$PR_DIR/state"
}

ensure_exclude() {
  local f
  f="$(git -C "$PROJECT_DIR" rev-parse --git-path info/exclude 2>/dev/null)" || return 0
  [[ "$f" = /* ]] || f="$PROJECT_DIR/$f"
  mkdir -p "$(dirname "$f")"
  grep -qxF '.phase-runner/' "$f" 2>/dev/null || echo '.phase-runner/' >> "$f"
}

# phases manifest: one project-relative path per line, optionally followed by
# per-phase options (`docs/phases/X.md effort=medium`) that the driver reads
# itself; '#' comments and blank lines are ignored. Returns the paths only.
read_manifest() {
  [[ -f "$1" ]] || return 0
  sed -e 's/#.*//' "$1" | awk 'NF { printf "%s%s", (n++ ? " " : ""), $1 }'
}

load_config() {
  CONFIG="$PR_DIR/runner.env"
  [[ -f "$CONFIG" ]] || die "no config at $(rel "$CONFIG") — run 'phase-runner init' first"
  set -a
  # shellcheck source=/dev/null
  source "$CONFIG"
  set +a
  [[ -n "${ENTRY_FILE:-}" ]] || die "ENTRY_FILE is not set in $(rel "$CONFIG")"
  [[ -f "$PROJECT_DIR/$ENTRY_FILE" ]] || die "entry file not found: $ENTRY_FILE (relative to $PROJECT_DIR)"
  if [[ -z "${PHASE_FILES:-}" ]]; then
    PHASE_FILES="$(read_manifest "$PR_DIR/phases")"
    [[ -n "$PHASE_FILES" ]] || die "no phases: list them in $(rel "$PR_DIR/phases") (one per line, in order)"
  fi
  local p
  for p in $PHASE_FILES; do
    [[ -f "$PROJECT_DIR/$p" ]] || die "phase file not found: $p (relative to $PROJECT_DIR)"
  done
  export ENTRY_FILE PHASE_FILES
}

rel() { printf '%s' "${1#"$PROJECT_DIR"/}"; }

resolve_credentials() {
  local c
  for c in "${PHASE_RUNNER_CREDENTIALS:-}" \
           "${XDG_CONFIG_HOME:-$HOME/.config}/claude-phase-runner/credentials.env" \
           "$KIT_DIR/credentials.env"; do
    [[ -n "$c" && -f "$c" ]] && { CREDENTIALS_FILE="$c"; break; }
  done
  [[ -n "${CREDENTIALS_FILE:-}" ]] || die "no credentials file. Create ~/.config/claude-phase-runner/credentials.env from $KIT_DIR/templates/credentials.env"
  [[ "$CREDENTIALS_FILE" == "$KIT_DIR/credentials.env" ]] \
    && warn "using $CREDENTIALS_FILE (legacy location) — move it to ~/.config/claude-phase-runner/credentials.env"
  grep -qE '^(CLAUDE_CODE_OAUTH_TOKEN|ANTHROPIC_API_KEY)=.+' "$CREDENTIALS_FILE" \
    || die "$CREDENTIALS_FILE sets neither CLAUDE_CODE_OAUTH_TOKEN nor ANTHROPIC_API_KEY"
  export CREDENTIALS_FILE
}

# ── Commands ──────────────────────────────────────────────────────────────────
cmd_init() {
  resolve_project
  mkdir -p "$PR_DIR"
  local created=()
  [[ -f "$PR_DIR/runner.env" ]] || { cp "$KIT_DIR/templates/runner.env" "$PR_DIR/runner.env"; created+=(runner.env); }
  [[ -f "$PR_DIR/phases" ]]     || { cp "$KIT_DIR/templates/phases" "$PR_DIR/phases"; created+=(phases); }
  ensure_exclude
  info "Project: $PROJECT_DIR"
  if (( ${#created[@]} )); then
    info "Created .phase-runner/${created[*]/#/ } (excluded from git via .git/info/exclude)"
  else
    info ".phase-runner/ already initialised — nothing changed"
  fi
  cat <<EOF

Next:
  1. Edit .phase-runner/runner.env   — ENTRY_FILE, GATE_CMD, models, push settings
  2. Edit .phase-runner/phases       — the phase plan files, one per line, in order
  3. Credentials once per machine    — ~/.config/claude-phase-runner/credentials.env
                                       (template: $KIT_DIR/templates/credentials.env)
  4. phase-runner build --dry-run    — prints the exact first builder prompt, launches nothing
  5. phase-runner preflight          — optional: what tooling/credentials the plan needs
  6. phase-runner build              — run it (use tmux; Ctrl-C is safe at any time)
EOF
}

# docker-compose.yml bind-mounts this kit's docker/ and prompts/ live into the
# container. When the project IS the kit, the builder's edits land in the
# running runner: driver.sh is executed incrementally from the file, prompts
# are re-read per role and guard.sh is started fresh for every tool call — a
# half-edited guard.sh exits 2 and blocks every call, including the repair.
refuse_self_hosting() {
  [[ "$PROJECT_DIR" -ef "$KIT_DIR" ]] || return 0
  warn "The project is this kit itself: $PROJECT_DIR"
  warn "The kit's docker/ and prompts/ are mounted live into the run, so the builder's edits would change the runner while it runs."
  warn "Build the kit from a frozen clone instead:"
  warn "    git clone $KIT_DIR /tmp/phase-runner-frozen"
  warn "    /tmp/phase-runner-frozen/bin/phase-runner --project $PROJECT_DIR $CMD"
  die "refusing to start a container with the kit as the project"
}

cmd_run() {  # cmd_run MODE
  resolve_project
  refuse_self_hosting
  load_config
  resolve_credentials
  ensure_exclude
  mkdir -p "$STATE/logs"

  AGENT_HOME="${AGENT_HOME:-$PR_DIR/home}"
  [[ "$AGENT_HOME" = /* ]] || AGENT_HOME="$PROJECT_DIR/$AGENT_HOME"
  mkdir -p "$AGENT_HOME"

  export HOST_SSH_AUTH_SOCK="${SSH_AUTH_SOCK:-/dev/null}"
  if [[ "$HOST_SSH_AUTH_SOCK" == "/dev/null" && "${PUSH:-1}" == "1" && "$1" == "build" ]]; then
    local remote_url
    remote_url="$(git -C "$PROJECT_DIR" remote get-url "${GIT_REMOTE:-origin}" 2>/dev/null || true)"
    if [[ "$remote_url" == git@* || "$remote_url" == ssh://* ]]; then
      warn "No SSH agent (SSH_AUTH_SOCK unset) but the push remote is SSH: $remote_url"
      warn "Start one (eval \$(ssh-agent); ssh-add) or the per-phase push will fail."
    fi
  fi

  # The host's Docker socket lets the agent run the project's stack and test
  # containers on the host daemon — and is effectively root on the host. Unset
  # keeps it mounted (projects that predate the setting); 0 mounts /dev/null.
  DOCKER_SOCKET="${DOCKER_SOCKET:-1}"
  case "$DOCKER_SOCKET" in
    1) HOST_DOCKER_SOCK=/var/run/docker.sock ;;
    0) HOST_DOCKER_SOCK=/dev/null ;;
    *) die "DOCKER_SOCKET must be 0 or 1 in $(rel "$CONFIG") (got '$DOCKER_SOCKET')" ;;
  esac
  export DOCKER_SOCKET HOST_DOCKER_SOCK

  export RUNNER_MODE="$1" PROJECT_DIR AGENT_HOME
  info "Project:   $PROJECT_DIR"
  info "Entry:     $ENTRY_FILE"
  info "Phases:    $PHASE_FILES"
  info "Mode:      $1"
  info "Reviewer:  ${PHASE_REVIEW:-1} (fix rounds ≤ ${MAX_FIX_ROUNDS:-2}) · gate: ${GATE_CMD:-none}"
  info "Push:      ${PUSH:-1} → ${GIT_REMOTE:-origin}/${GIT_BRANCH:-<current>}"
  if [[ "$DOCKER_SOCKET" == "1" ]]; then
    info "Docker:    host socket mounted — the agent can drive the host daemon (DOCKER_SOCKET=0 turns it off)"
  else
    info "Docker:    no host socket — the agent has no Docker daemon (DOCKER_SOCKET=0)"
  fi
  info "State:     $(rel "$STATE") · agent home: $(rel "$AGENT_HOME")"

  local compose=(docker compose -f "$KIT_DIR/docker-compose.yml")
  if docker image inspect claude-phase-runner:latest >/dev/null 2>&1; then
    "${compose[@]}" build --quiet runner || die "image build failed"
  else
    info "Building the runner image (first run; takes a few minutes)"
    "${compose[@]}" build runner || die "image build failed"
  fi
  local tty=()
  [[ -t 0 && -t 1 ]] || tty=(-T)
  exec "${compose[@]}" run --rm "${tty[@]}" runner
}

cmd_status() {
  resolve_project
  [[ -f "$PR_DIR/runner.env" ]] || die "no .phase-runner/runner.env — run 'phase-runner init'"
  local phases
  phases="$(read_manifest "$PR_DIR/phases")"
  if [[ -z "$phases" ]]; then
    phases="$( (set -a; source "$PR_DIR/runner.env" 2>/dev/null; printf '%s' "${PHASE_FILES:-}") )"
  fi
  [[ -n "$phases" ]] || die "no phases listed in $(rel "$PR_DIR/phases")"
  local done_f="$STATE/phases-done" blocked_f="$STATE/blocked" runs="$STATE/runs.tsv"
  local p status verdict rounds cost min
  printf '%-46s %-11s %-8s %6s %9s %6s\n' PHASE STATUS VERDICT ROUNDS COST MIN
  for p in $phases; do
    status=pending; verdict=-; rounds=-; cost=-; min=-
    if grep -qxF "$p" "$done_f" 2>/dev/null; then status="done"
    elif grep -qF "$p	" "$blocked_f" 2>/dev/null; then status=BLOCKED
    fi
    if [[ -f "$runs" ]]; then
      read -r rounds cost min verdict < <(awk -F'\t' -v p="$p" '
        NR > 1 && $2 == p {
          if ($3 == "build" || $3 == "fix" || $3 == "review") { c += $7; s += $6; seen = 1 }
          if ($3 == "fix" && $4 + 0 > r) r = $4 + 0
          if ($3 == "review") v = $5
        }
        END { if (seen) printf "%d %.2f %d %s\n", r, c, s / 60, (v == "" ? "-" : v); else print "- - - -" }' "$runs")
      [[ "$status" == pending && "$rounds" != "-" ]] && status=partial
    fi
    printf '%-46s %-11s %-8s %6s %9s %6s\n' "$p" "$status" "$verdict" "$rounds" "$cost" "$min"
  done
  if [[ -f "$runs" ]]; then
    awk -F'\t' 'NR > 1 && $3 != "gate" && $3 != "push" { c += $7; s += $6 }
      END { printf "\nAgent cost so far: $%.2f · agent time: %d min\n", c, s / 60 }' "$runs"
  fi
  if [[ -s "$blocked_f" ]]; then
    echo; echo "Blocked:"
    awk -F'\t' '{ print "  " $1 " — " $2 }' "$blocked_f"
  fi
  [[ -f "$STATE/SUMMARY.md" ]] && { echo; echo "Last run: $(head -1 "$STATE/SUMMARY.md" | sed 's/^# //')"; }
  echo "Verdicts: $(rel "$STATE")/reviews/ · logs: phase-runner logs [PHASE] [-f] · the runner's own log: phase-runner logs driver"
}

cmd_logs() {
  resolve_project
  local follow=0 pick="" a f="" cand
  for a in "${ARGS[@]}"; do
    case "$a" in -f|--follow) follow=1 ;; *) pick="$a" ;; esac
  done
  [[ -d "$STATE/logs" ]] || die "no logs yet in $(rel "$STATE")/logs"
  # driver.log is the runner's own account and, during a run, always the newest
  # file: it is shown only when asked for by name, never as "the latest log".
  if [[ "$pick" == driver ]]; then
    f="$STATE/logs/driver.log"; [[ -f "$f" ]] || f=""
  else
    while IFS= read -r cand; do
      [[ "$cand" == */driver.log ]] || { f="$cand"; break; }
    done < <(ls -t "$STATE/logs"/*"$pick"*.log 2>/dev/null)
  fi
  [[ -n "$f" ]] || die "no log matching '$pick' in $(rel "$STATE")/logs"
  info "$(rel "$f")"
  local raw=0
  [[ "$f" == *.gate.* || "$f" == */push.log || "$f" == */driver.log ]] && raw=1
  command -v jq >/dev/null || { warn "jq not installed — showing raw stream-json"; raw=1; }
  if (( raw )); then
    if (( follow )); then tail -n +1 -F "$f"; else cat "$f"; fi
  elif (( follow )); then
    tail -n +1 -F "$f" | jq -R -r --unbuffered -f "$KIT_DIR/docker/lib/render.jq"
  else
    jq -R -r -f "$KIT_DIR/docker/lib/render.jq" "$f"
  fi
}

cmd_reset() {
  resolve_project
  [[ -d "$STATE" ]] || { info "nothing to reset in $(rel "$PR_DIR")"; return 0; }
  if ! has_arg --yes; then
    read -r -p "Delete $(rel "$STATE") (phases-done, logs, verdicts, runs)? [y/N] " a
    [[ "$a" == y* || "$a" == Y* ]] || exit 1
  fi
  rm -rf "$STATE"
  info "State removed. Config, phases and the agent home in $(rel "$PR_DIR") are kept."
  info "The repository keeps whatever was committed; reset the branch yourself if the code should go too."
}

case "$CMD" in
  init)      cmd_init ;;
  build)     if has_arg --dry-run || [[ -n "${DRY_RUN:-}" ]]; then cmd_run dry-run; else cmd_run build; fi ;;
  dry-run)   cmd_run dry-run ;;
  preflight) cmd_run preflight ;;
  review)    cmd_run review ;;
  status)    cmd_status ;;
  logs)      cmd_logs ;;
  reset)     cmd_reset ;;
  *) usage >&2; die "unknown command: $CMD" ;;
esac
