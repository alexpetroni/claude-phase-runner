# Phase-runner configuration. Copy to runner.env and edit.
# All paths except PROJECT_DIR are RELATIVE TO THE PROJECT ROOT.

# Absolute path of the target project on the host (must be a git repo).
PROJECT_DIR=/home/alex/work/my-next-project

# The entry/constitution prompt file: read first, prepended to every phase
# prompt. The equivalent of grounded-flow's docker/builder/PROMPT.md — mission,
# rules, invariants, how to verify. Keep phase scoping OUT of it; the runner
# adds that per phase.
ENTRY_FILE=docker/builder/PROMPT.md

# Ordered, space-separated phase plan files. One agent run per file, in order.
PHASE_FILES="docs/PHASE-0-PLAN.md docs/PHASE-1-PLAN.md docs/PHASE-2-PLAN.md docs/PHASE-3-PLAN.md docs/PHASE-4-PLAN.md docs/PHASE-5-PLAN.md docs/PHASE-6-PLAN.md"

# Seconds to wait before each retry after a transient API failure/hang.
# The list's length IS the retry count: below = 4 retries (30s, 5m, 1h, 3h).
RETRY_SCHEDULE="30 300 3600 10800"

# Kill + retry the agent if it produces no output for this many seconds.
# Keep comfortably above your slowest silent step (docker builds, big test
# suites run as ONE tool call and emit nothing until they finish).
STALL_TIMEOUT=1800

# Optional: independent verification command run after every phase (from the
# project root). If it fails, the agent gets ONE remediation run, then the
# gates run again; still red aborts. Empty = trust the agent's own checks.
GATE_CMD="pnpm lint && pnpm typecheck && pnpm test"

# The pre-build tooling assessment and the post-build adversarial review are
# subcommands, not settings — they only report, changing nothing:
#   bash run.sh preflight   # writes state/TOOLING.md (what to provision), then stops
#   bash run.sh review      # writes state/REVIEW.md (what to improve), then stops
#
# Optional: override just the review instruction (the entry file is still
# prepended for grounding). Empty = the built-in adversarial-review wording.
#REVIEW_PROMPT="Now make an adversarial evaluation on what can be improved, simplified, made more resilient. Do it thoroughly."

# Commit + push after every phase. The agent commits its own work; the runner
# additionally checkpoints anything left uncommitted, then pushes.
PUSH=1
GIT_REMOTE=origin
# Empty = the branch currently checked out in PROJECT_DIR.
GIT_BRANCH=

# Optional overrides.
#CLAUDE_MODEL=claude-fable-5
#GIT_AUTHOR_NAME=Phase Runner
#GIT_AUTHOR_EMAIL=runner@phase.local
# Extra apt packages for non-JS toolchains (applied at image build).
#EXTRA_APT_PACKAGES="python3 python3-pip"
